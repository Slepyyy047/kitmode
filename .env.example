# Keep secrets in .env locally. Never commit .env or your SQLite data.
TELEGRAM_BOT_TOKEN=
KITMODE_DB=data/kitmode.sqlite3
# Numeric Telegram user IDs separated by commas; empty disables administration.
ADMIN_IDS=
# Both flags must be true to permit potentially paid requests. Default: zero calls.
AI_ENABLED=false
AI_SPENDING_APPROVED=false
OPENAI_API_KEY=
# Explicit provider model name, not assumed available to your account.
OPENAI_MODEL=
AI_DAILY_LIMIT=3
